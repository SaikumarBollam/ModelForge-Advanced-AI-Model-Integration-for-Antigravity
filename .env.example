# ModelForge — copy to .env. Never commit real secrets.
# Master key for the encrypted credential vault (32+ chars). If unset, a key file
# is generated under MODELFORGE_DATA_DIR (mode 0600 where supported).
MODELFORGE_MASTER_KEY=
MODELFORGE_DATA_DIR=./data
MODELFORGE_PORT=8787
MODELFORGE_HOST=127.0.0.1
# Optional: require this key (Bearer) for /v1/* gateway routes when set.
MODELFORGE_GATEWAY_API_KEY=
# Optional: require this key for /api/* admin routes when set. Strongly recommended remotely.
MODELFORGE_ADMIN_API_KEY=
# Allow gateway/admin to reach private/loopback upstream URLs (needed for Ollama etc.).
# Default true for loopback-only local providers, false for arbitrary remote URLs.
MODELFORGE_ALLOW_PRIVATE_UPSTREAMS=true
MODELFORGE_LOG_LEVEL=info
# Provider keys may also be supplied per-connection in the dashboard (stored encrypted),
# or via env using the pattern MODELFORGE_KEY_<CONNECTION_ID>.
