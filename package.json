{
  "name": "modelforge",
  "version": "0.1.0",
  "private": true,
  "description": "ModelForge — Universal AI Provider Management, Model Gateway & Antigravity Integration Platform",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "integrations/*"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build:dashboard",
    "build:dashboard": "npm run build -w @modelforge/dashboard",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @modelforge/dashboard",
    "lint": "eslint . --max-warnings 0 || true",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:gateway": "npm run dev -w @modelforge/gateway",
    "dev:dashboard": "npm run dev -w @modelforge/dashboard",
    "start:gateway": "npm run start -w @modelforge/gateway"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
